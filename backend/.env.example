# ==============================================================================
# HKBAMS BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (External MySQL)
# ------------------------------------------------------------------------------
# Option 1: Full Connection URL (Recommended for Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="mysql://username:password@remote-mysql-host.com:3306/hkbams"

# Option 2: Discrete parameters (Auto-composed into DATABASE_URL if DATABASE_URL is not set)
# DB_HOST=remote-mysql-host.com
# DB_PORT=3306
# DB_NAME=hkbams
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_SSL=true

# ------------------------------------------------------------------------------
# AUTHENTICATION / JWT
# ------------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-strong-random-production-jwt-secret"
JWT_EXPIRES_IN="8h"

# ------------------------------------------------------------------------------
# CORS CONFIGURATION (Frontend Origin)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. Vercel deployment URL)
FRONTEND_URL="https://your-project.vercel.app"

